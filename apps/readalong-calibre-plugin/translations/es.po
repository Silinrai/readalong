msgstr "No en Readalong"

msgid "No Readalong-supported format (EPUB, PDF, ...)"
msgstr "Ningún formato compatible con Readalong (EPUB, PDF, ...)"

msgid "Book file is missing from the calibre library"
msgstr "El archivo del libro falta en la biblioteca de calibre"

msgid "Nothing to push."
msgstr "Nada que enviar."

msgid "Nothing to check."
msgstr "Nada que comprobar."

msgid "Please log in to Readalong first. (%s)"
msgstr "Inicie sesión en Readalong primero. (%s)"

msgid "Could not reach Readalong: %s"
msgstr "No se pudo contactar con Readalong: %s"

msgid "Canceled."
msgstr "Cancelado."

msgid "Readalong storage quota exceeded — push stopped."
msgstr "Cuota de almacenamiento de Readalong superada: envío detenido."

msgid "Session expired — please log in again."
