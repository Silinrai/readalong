msgid "Push selected books and their metadata into your Readalong cloud library. Re-pushing a book updates its existing entry instead of creating a duplicate."
msgstr "Envíe los libros seleccionados y sus metadatos a su biblioteca en la nube de Readalong. Al volver a enviar un libro se actualiza su entrada existente en lugar de crear un duplicado."

msgid "Not logged in."
msgstr "No ha iniciado sesión."

msgid "Include custom columns in pushed metadata"
msgstr "Incluir columnas personalizadas en los metadatos enviados"

msgid "Only change this if you run a self-hosted Readalong server."
msgstr "Cambie esto solo si utiliza un servidor Readalong autoalojado."

msgid "Logged in as %s."
msgstr "Sesión iniciada como %s."

msgid "API server:"
msgstr "Servidor de API:"

msgid "Use the Readalong toolbar menu to log in or out."
msgstr "Use el menú Readalong de la barra de herramientas para iniciar o cerrar sesión."

msgid "Push to Readalong"
msgstr "Enviar a Readalong"

msgid "Push to Readalong failed"
msgstr "Error al enviar a Readalong"

msgid "Readalong status"
msgstr "Estado de Readalong"

msgid "Readalong status check failed"
msgstr "Error al comprobar el estado de Readalong"

msgid "Log in to Readalong"
msgstr "Iniciar sesión en Readalong"

msgid "Email:"
msgstr "Correo electrónico:"

msgid "Password:"
msgstr "Contraseña:"

msgid "Log in"
msgstr "Iniciar sesión"

msgid "Logging in…"
msgstr "Iniciando sesión…"

msgid "Waiting for the browser login to complete…"
msgstr "Esperando que se complete el inicio de sesión en el navegador…"

msgid "Unknown"
msgstr "Desconocido"

msgid "Pushing %d book to your Readalong library…"
msgid_plural "Pushing %d books to your Readalong library…"
msgstr[0] "Enviando %d libro a su biblioteca Readalong…"
msgstr[1] "Enviando %d libros a su biblioteca Readalong…"

msgid "Checking %d book against your Readalong library…"
msgid_plural "Checking %d books against your Readalong library…"
msgstr[0] "Comprobando %d libro contra su biblioteca Readalong…"
msgstr[1] "Comprobando %d libros contra su biblioteca Readalong…"

msgid "Or sign in with your browser:"
msgstr "O inicie sesión con su navegador:"

msgid "Please enter both email and password."
msgstr "Introduzca el correo electrónico y la contraseña."

msgid "Login failed: the browser callback carried no session."
msgstr "Error de inicio de sesión: la respuesta del navegador no contenía ninguna sesión."

msgid "Book"
msgstr "Libro"

msgid "Status"
msgstr "Estado"

msgid "Details"
msgstr "Detalles"

msgid "Canceling…"
msgstr "Cancelando…"

msgid "Browser login timed out. Try again."
msgstr "El inicio de sesión en el navegador caducó. Inténtelo de nuevo."

msgid "Login failed: %s"
msgstr "Error de inicio de sesión: %s"

msgid "Readalong Login"
msgstr "Inicio de sesión en Readalong"

msgid "Completing login…"
msgstr "Completando el inicio de sesión…"

msgid "Login complete. You can close this tab and return to calibre."
msgstr "Inicio de sesión completado. Puede cerrar esta pestaña y volver a calibre."

msgid "Readalong"
msgstr "Readalong"

msgid "Push selected books and metadata to your Readalong library"
msgstr "Enviar los libros seleccionados y sus metadatos a su biblioteca Readalong"

msgid "Select the books to push to Readalong."
msgstr "Seleccione los libros que desea enviar a Readalong."

msgid "Select the books to check against Readalong."
msgstr "Seleccione los libros que desea comprobar con Readalong."

msgid "No books selected"
msgstr "No hay libros seleccionados"

msgid "Push selected books to Readalong"
msgstr "Enviar los libros seleccionados a Readalong"

msgid "Check Readalong status"
msgstr "Comprobar el estado de Readalong"

msgid "Log in to Readalong…"
msgstr "Iniciar sesión en Readalong…"

msgid "Log out"
msgstr "Cerrar sesión"

msgid "Customize plugin…"
msgstr "Personalizar complemento…"

msgid "Log out (%s)"
msgstr "Cerrar sesión (%s)"

msgid "your Readalong account"
msgstr "su cuenta de Readalong"

msgid "Uploaded"
msgstr "Subido"

msgid "Replaced"
msgstr "Reemplazado"

msgid "Updated"
msgstr "Actualizado"

msgid "Up to date"
msgstr "Al día"

