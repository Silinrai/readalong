msgid "Push selected books and their metadata into your Readalong cloud library. Re-pushing a book updates its existing entry instead of creating a duplicate."
msgstr "Envie os livros selecionados e seus metadados para sua biblioteca na nuvem Readalong. Reenviar um livro atualiza a entrada existente em vez de criar uma duplicata."

msgid "Not logged in."
msgstr "Não conectado."

msgid "Include custom columns in pushed metadata"
msgstr "Incluir colunas personalizadas nos metadados enviados"

msgid "Only change this if you run a self-hosted Readalong server."
msgstr "Altere isto somente se você executar um servidor Readalong auto-hospedado."

msgid "Logged in as %s."
msgstr "Conectado como %s."

msgid "API server:"
msgstr "Servidor de API:"

msgid "Use the Readalong toolbar menu to log in or out."
msgstr "Use o menu Readalong da barra de ferramentas para entrar ou sair."

msgid "Push to Readalong"
msgstr "Enviar para o Readalong"

msgid "Push to Readalong failed"
msgstr "Falha ao enviar para o Readalong"

msgid "Readalong status"
msgstr "Situação do Readalong"

msgid "Readalong status check failed"
msgstr "Falha na verificação da situação do Readalong"

msgid "Log in to Readalong"
msgstr "Entrar no Readalong"

