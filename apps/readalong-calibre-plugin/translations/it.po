msgstr[0] "Invio di %d libro alla tua libreria Readalong…"
msgstr[1] "Invio di %d libri alla tua libreria Readalong…"

msgid "Checking %d book against your Readalong library…"
msgid_plural "Checking %d books against your Readalong library…"
msgstr[0] "Controllo di %d libro nella tua libreria Readalong…"
msgstr[1] "Controllo di %d libri nella tua libreria Readalong…"

msgid "Or sign in with your browser:"
msgstr "Oppure accedi con il browser:"

msgid "Please enter both email and password."
msgstr "Inserisci sia l'e-mail che la password."

msgid "Login failed: the browser callback carried no session."
msgstr "Accesso non riuscito: la risposta del browser non conteneva alcuna sessione."

msgid "Book"
msgstr "Libro"

msgid "Status"
msgstr "Stato"

msgid "Details"
msgstr "Dettagli"

msgid "Canceling…"
msgstr "Annullamento…"

msgid "Browser login timed out. Try again."
msgstr "Accesso tramite browser scaduto. Riprova."

msgid "Login failed: %s"
msgstr "Accesso non riuscito: %s"

msgid "Readalong Login"
msgstr "Accesso a Readalong"

msgid "Completing login…"
msgstr "Completamento dell'accesso…"

msgid "Login complete. You can close this tab and return to calibre."
msgstr "Accesso completato. Puoi chiudere questa scheda e tornare a calibre."

msgid "Readalong"
msgstr "Readalong"

msgid "Push selected books and metadata to your Readalong library"
msgstr "Invia i libri selezionati e i metadati alla tua libreria Readalong"

msgid "Select the books to push to Readalong."
msgstr "Seleziona i libri da inviare a Readalong."

msgid "Select the books to check against Readalong."
msgstr "Seleziona i libri da controllare su Readalong."

msgid "No books selected"
msgstr "Nessun libro selezionato"

msgid "Push selected books to Readalong"
msgstr "Invia i libri selezionati a Readalong"

msgid "Check Readalong status"
msgstr "Controlla lo stato di Readalong"

msgid "Log in to Readalong…"
msgstr "Accedi a Readalong…"

msgid "Log out"
msgstr "Esci"

