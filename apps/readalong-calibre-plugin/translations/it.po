msgid "Push selected books and their metadata into your Readalong cloud library. Re-pushing a book updates its existing entry instead of creating a duplicate."
msgstr "Invia i libri selezionati e i relativi metadati alla tua libreria cloud Readalong. Reinviando un libro si aggiorna la voce esistente invece di crearne un duplicato."

msgid "Not logged in."
msgstr "Accesso non effettuato."

msgid "Include custom columns in pushed metadata"
msgstr "Includi colonne personalizzate nei metadati inviati"

msgid "Only change this if you run a self-hosted Readalong server."
msgstr "Modifica questo solo se usi un server Readalong auto-ospitato."

msgid "Logged in as %s."
msgstr "Accesso effettuato come %s."

msgid "API server:"
msgstr "Server API:"

msgid "Use the Readalong toolbar menu to log in or out."
msgstr "Usa il menu Readalong della barra degli strumenti per accedere o uscire."

msgid "Push to Readalong"
msgstr "Invia a Readalong"

msgid "Push to Readalong failed"
msgstr "Invio a Readalong non riuscito"

msgid "Readalong status"
msgstr "Stato di Readalong"

msgid "Readalong status check failed"
msgstr "Controllo dello stato di Readalong non riuscito"

msgid "Log in to Readalong"
msgstr "Accedi a Readalong"

msgid "Email:"
msgstr "E-mail:"

msgid "Password:"
msgstr "Password:"

msgid "Log in"
msgstr "Accedi"

msgid "Logging in…"
msgstr "Accesso in corso…"

msgid "Waiting for the browser login to complete…"
