msgid "Unknown"
msgstr "Nieznany"

msgid "Pushing %d book to your Readalong library…"
msgid_plural "Pushing %d books to your Readalong library…"
msgstr[0] "Wysyłanie %d książki do Twojej biblioteki Readalong…"
msgstr[1] "Wysyłanie %d książek do Twojej biblioteki Readalong…"
msgstr[2] "Wysyłanie %d książek do Twojej biblioteki Readalong…"

msgid "Checking %d book against your Readalong library…"
msgid_plural "Checking %d books against your Readalong library…"
msgstr[0] "Sprawdzanie %d książki w Twojej bibliotece Readalong…"
msgstr[1] "Sprawdzanie %d książek w Twojej bibliotece Readalong…"
msgstr[2] "Sprawdzanie %d książek w Twojej bibliotece Readalong…"

msgid "Or sign in with your browser:"
msgstr "Albo zaloguj się przez przeglądarkę:"

msgid "Please enter both email and password."
msgstr "Podaj zarówno e-mail, jak i hasło."

msgid "Login failed: the browser callback carried no session."
msgstr "Logowanie nie udało się: odpowiedź przeglądarki nie zawierała sesji."

msgid "Book"
msgstr "Książka"

msgid "Status"
msgstr "Stan"

msgid "Details"
msgstr "Szczegóły"

msgid "Canceling…"
msgstr "Anulowanie…"

msgid "Browser login timed out. Try again."
msgstr "Logowanie w przeglądarce przekroczyło czas. Spróbuj ponownie."

msgid "Login failed: %s"
msgstr "Logowanie nie udało się: %s"

msgid "Readalong Login"
msgstr "Logowanie do Readalong"

msgid "Completing login…"
msgstr "Kończenie logowania…"

msgid "Login complete. You can close this tab and return to calibre."
msgstr "Logowanie zakończone. Możesz zamknąć tę kartę i wrócić do calibre."

msgid "Readalong"
msgstr "Readalong"

msgid "Push selected books and metadata to your Readalong library"
msgstr "Wysyła wybrane książki i metadane do Twojej biblioteki Readalong"

msgid "Select the books to push to Readalong."
msgstr "Wybierz książki do wysłania do Readalong."

msgid "Select the books to check against Readalong."
msgstr "Wybierz książki do sprawdzenia w Readalong."

msgid "No books selected"
msgstr "Nie wybrano żadnej książki"

msgid "Push selected books to Readalong"
msgstr "Wyślij wybrane książki do Readalong"

msgid "Check Readalong status"
