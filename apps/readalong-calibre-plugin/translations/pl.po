msgid "Push selected books and their metadata into your Readalong cloud library. Re-pushing a book updates its existing entry instead of creating a duplicate."
msgstr "Wysyła wybrane książki i ich metadane do Twojej biblioteki Readalong w chmurze. Ponowne wysłanie książki aktualizuje istniejący wpis zamiast tworzyć duplikat."

msgid "Not logged in."
msgstr "Nie zalogowano."

msgid "Include custom columns in pushed metadata"
msgstr "Dołącz własne kolumny do wysyłanych metadanych"

msgid "Only change this if you run a self-hosted Readalong server."
msgstr "Zmień to tylko, jeśli korzystasz z własnego serwera Readalong."

msgid "Logged in as %s."
msgstr "Zalogowano jako %s."

msgid "API server:"
msgstr "Serwer API:"

msgid "Use the Readalong toolbar menu to log in or out."
msgstr "Użyj menu Readalong na pasku narzędzi, aby się zalogować lub wylogować."

msgid "Push to Readalong"
msgstr "Wyślij do Readalong"

msgid "Push to Readalong failed"
msgstr "Wysyłanie do Readalong nie udało się"

msgid "Readalong status"
msgstr "Stan Readalong"

msgid "Readalong status check failed"
msgstr "Sprawdzanie stanu Readalong nie udało się"

msgid "Log in to Readalong"
msgstr "Zaloguj się do Readalong"

msgid "Email:"
msgstr "E-mail:"

msgid "Password:"
msgstr "Hasło:"

msgid "Log in"
msgstr "Zaloguj się"

msgid "Logging in…"
msgstr "Logowanie…"

msgid "Waiting for the browser login to complete…"
