msgid "Log in to Readalong…"
msgstr "Zaloguj się do Readalong…"

msgid "Log out"
msgstr "Wyloguj się"

msgid "Customize plugin…"
msgstr "Dostosuj wtyczkę…"

msgid "Log out (%s)"
msgstr "Wyloguj się (%s)"

msgid "your Readalong account"
msgstr "Twoje konto Readalong"

msgid "Uploaded"
msgstr "Przesłana"

msgid "Replaced"
msgstr "Zastąpiona"

msgid "Updated"
msgstr "Zaktualizowana"

msgid "Up to date"
msgstr "Aktualna"

msgid "Failed"
msgstr "Nie udała się"

