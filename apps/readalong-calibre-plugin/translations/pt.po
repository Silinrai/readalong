msgid "Push selected books and their metadata into your Readalong cloud library. Re-pushing a book updates its existing entry instead of creating a duplicate."
msgstr "Envie os livros selecionados e os seus metadados para a sua biblioteca na nuvem Readalong. Reenviar um livro atualiza a entrada existente em vez de criar uma duplicada."

msgid "Not logged in."
msgstr "Sessão não iniciada."

msgid "Include custom columns in pushed metadata"
msgstr "Incluir colunas personalizadas nos metadados enviados"

msgid "Only change this if you run a self-hosted Readalong server."
msgstr "Altere isto apenas se executar um servidor Readalong autoalojado."

msgid "Logged in as %s."
msgstr "Sessão iniciada como %s."

msgid "API server:"
msgstr "Servidor de API:"

msgid "Use the Readalong toolbar menu to log in or out."
msgstr "Use o menu Readalong da barra de ferramentas para iniciar ou terminar sessão."

msgid "Push to Readalong"
msgstr "Enviar para o Readalong"

msgid "Push to Readalong failed"
msgstr "Falha ao enviar para o Readalong"

msgid "Readalong status"
msgstr "Estado do Readalong"

msgid "Readalong status check failed"
msgstr "Falha na verificação do estado do Readalong"

msgid "Log in to Readalong"
msgstr "Iniciar sessão no Readalong"

msgid "Email:"
msgstr "E-mail:"

msgid "Password:"
msgstr "Palavra-passe:"

msgid "Log in"
msgstr "Iniciar sessão"

msgid "Logging in…"
msgstr "A iniciar sessão…"

msgid "Waiting for the browser login to complete…"
msgstr "A aguardar a conclusão do início de sessão no navegador…"

msgid "Unknown"
msgstr "Desconhecido"

msgid "Pushing %d book to your Readalong library…"
msgid_plural "Pushing %d books to your Readalong library…"
msgstr[0] "A enviar %d livro para a sua biblioteca Readalong…"
msgstr[1] "A enviar %d livros para a sua biblioteca Readalong…"

msgid "Checking %d book against your Readalong library…"
msgid_plural "Checking %d books against your Readalong library…"
msgstr[0] "A verificar %d livro na sua biblioteca Readalong…"
msgstr[1] "A verificar %d livros na sua biblioteca Readalong…"

msgid "Or sign in with your browser:"
msgstr "Ou inicie sessão com o seu navegador:"

msgid "Please enter both email and password."
msgstr "Introduza o e-mail e a palavra-passe."

msgid "Login failed: the browser callback carried no session."
msgstr "Falha ao iniciar sessão: a resposta do navegador não trouxe nenhuma sessão."

msgid "Book"
msgstr "Livro"

msgid "Status"
msgstr "Estado"

msgid "Details"
msgstr "Detalhes"

msgid "Canceling…"
msgstr "A cancelar…"

msgid "Browser login timed out. Try again."
msgstr "O início de sessão no navegador expirou. Tente novamente."

msgid "Login failed: %s"
msgstr "Falha ao iniciar sessão: %s"

msgid "Readalong Login"
msgstr "Início de sessão no Readalong"

msgid "Completing login…"
msgstr "A concluir o início de sessão…"

msgid "Login complete. You can close this tab and return to calibre."
msgstr "Início de sessão concluído. Pode fechar este separador e voltar ao calibre."

msgid "Readalong"
msgstr "Readalong"

msgid "Push selected books and metadata to your Readalong library"
msgstr "Enviar os livros selecionados e os metadados para a sua biblioteca Readalong"

msgid "Select the books to push to Readalong."
msgstr "Selecione os livros a enviar para o Readalong."

msgid "Select the books to check against Readalong."
msgstr "Selecione os livros a verificar no Readalong."

msgid "No books selected"
msgstr "Nenhum livro selecionado"

msgid "Push selected books to Readalong"
msgstr "Enviar os livros selecionados para o Readalong"

msgid "Check Readalong status"
msgstr "Verificar o estado do Readalong"

msgid "Log in to Readalong…"
msgstr "Iniciar sessão no Readalong…"

msgid "Log out"
msgstr "Terminar sessão"

